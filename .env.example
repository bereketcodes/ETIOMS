# Generate a unique secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-unique-random-secret

# Comma-separated exact browser origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional; defaults to a local SQLite database.
DATABASE_URL=sqlite:///./etioms.db
